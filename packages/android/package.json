{
  "name": "@cody/android",
  "private": true,
  "version": "1.14.41",
  "type": "module",
  "scripts": {
    "version": "bun scripts/sync-version.ts",
    "update": "bun run version && bunx @bubblewrap/cli update --manifest .",
    "build": "bun run update && bunx @bubblewrap/cli build --manifest . --skipPwaValidation",
