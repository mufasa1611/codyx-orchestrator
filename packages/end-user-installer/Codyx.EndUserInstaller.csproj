<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Codyx.EndUserInstaller</AssemblyName>
    <RootNamespace>Codyx.EndUserInstaller</RootNamespace>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\script\install-compiled.ps1" Link="Resources\install-compiled.ps1" LogicalName="Codyx.EndUserInstaller.Resources.install-compiled.ps1" />
    <EmbeddedResource Include="..\..\script\installer-verification.ps1" Link="Resources\installer-verification.ps1" LogicalName="Codyx.EndUserInstaller.Resources.installer-verification.ps1" />
  </ItemGroup>
</Project>
